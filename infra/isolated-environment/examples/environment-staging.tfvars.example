environment       = "staging"
project           = "onolys-staging"
hosting_site_id   = "onolys-staging-app"
audio_bucket_name = "onolys-staging-audio"
auth_project      = "onolys-staging"
manage_identity   = true
# Existing production workflow provenance resolver: reads staging only.
cloud_run_reader_members = ["serviceAccount:deployer-staging@onolys.iam.gserviceaccount.com"]
artifact_registry_reader_members = [
  "serviceAccount:deployer-staging@onolys.iam.gserviceaccount.com",
  "serviceAccount:deployer-prod@onolys.iam.gserviceaccount.com",
  "serviceAccount:service-1054076260967@serverless-robot-prod.iam.gserviceaccount.com",
]
app_base_url = "https://onolys-staging-app.web.app"
# Live staging has resend-api-key-staging seeded and wired on api and worker (verified 2026-11-26 with
# gcloud run services describe). CI plans and applies with this file, so it must match live.
resend_secret_wired = true
# Limited identity for pull_request previews (pr-preview*.yml); outputs feed STAGING_PREVIEW_WIF_PROVIDER / STAGING_PREVIEW_SA.
enable_pr_previews = true
# Optional: keep staging plans free of drift. deploy-staging sets GIT_SHA and
# LLM_* on every deploy, and Terraform owns them from these variables, so pass
# the live values (git_sha is the deployed commit sha string). Refresh after deploys.
# git_sha      = "<live staging sha>"
# llm_provider = "anthropic"
# llm_model    = "claude-sonnet-5-5"
# llm_effort   = "high"
