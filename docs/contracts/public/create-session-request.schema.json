{
  "$defs": {
    "ClientInfo": {
      "description": "What produced a session or interview (02-logging R13). Client-reported, so every field is\noptional and sanitized, never rejected: non-strings become absent, control characters are\nstripped, and values are cut to a cap. Unknown keys are ignored.",
      "properties": {
        "audio_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Web audio engine name and version",
          "title": "Audio Engine"
        },
        "recorder_mime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MediaRecorder container the web chose",
          "title": "Recorder Mime"
        },
        "user_agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Browser User-Agent, trimmed to 200 chars",
          "title": "User Agent"
        },
        "web_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Web build id (git SHA, or `dev`)",
          "title": "Web Version"
        }
      },
      "title": "ClientInfo",
      "type": "object"
    },
    "CodedSpan": {
      "additionalProperties": false,
      "description": "Exactly one half-open time (milliseconds) or zero-based turn range.",
      "oneOf": [
        {
          "properties": {
            "end_ms": {
              "type": "integer"
            },
            "end_turn": {
              "type": "null"
            },
            "start_ms": {
              "type": "integer"
            },
            "start_turn": {
              "type": "null"
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        },
        {
          "properties": {
            "end_ms": {
              "type": "null"
            },
            "end_turn": {
              "type": "integer"
            },
            "start_ms": {
              "type": "null"
            },
            "start_turn": {
              "type": "integer"
            }
          },
          "required": [
            "start_turn",
            "end_turn"
          ]
        }
      ],
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "end_turn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Turn"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "start_turn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Turn"
        }
      },
      "title": "CodedSpan",
      "type": "object"
    }
  },
  "$id": "create-session-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional: which web build, recorder and audio engine made the request"
    },
    "coded_span": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodedSpan"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Half-open milliseconds or zero-based turn range; null codes all turns."
    },
    "interview_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "An `ended`, not yet linked AI interview of the caller: the session takes its scenario language and title (unless `title` is set) and a prefilled rating draft",
      "title": "Interview Id"
    },
    "language": {
      "default": "auto",
      "description": "BCP-47 tag or `auto`",
      "title": "Language",
      "type": "string"
    },
    "n_runs": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "N Runs",
      "type": "integer"
    },
    "preset": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Allowlisted preset name",
      "title": "Preset"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "title": "CreateSessionRequest",
  "type": "object"
}
