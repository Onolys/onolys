{
  "$defs": {
    "OutputValidation": {
      "properties": {
        "attempts": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "first_issues": {
          "items": {
            "$ref": "#/$defs/OutputValidationIssue"
          },
          "maxItems": 10,
          "title": "First Issues",
          "type": "array"
        }
      },
      "required": [
        "attempts"
      ],
      "title": "OutputValidation",
      "type": "object"
    },
    "OutputValidationIssue": {
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "title": "OutputValidationIssue",
      "type": "object"
    },
    "RunView": {
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "code_version": {
          "title": "Code Version",
          "type": "string"
        },
        "ended": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "n_runs": {
          "title": "N Runs",
          "type": "integer"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "rating_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating Id"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_info": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Info"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "started": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "stt": {
          "anyOf": [
            {
              "$ref": "#/$defs/SttInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputValidation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "session_id",
        "status",
        "n_runs",
        "code_version",
        "attempts"
      ],
      "title": "RunView",
      "type": "object"
    },
    "SttInfo": {
      "properties": {
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/SttRun"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SttInfo",
      "type": "object"
    },
    "SttRun": {
      "properties": {
        "adapter_version": {
          "title": "Adapter Version",
          "type": "string"
        },
        "language_detected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Detected"
        },
        "language_requested": {
          "title": "Language Requested",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "language_requested",
        "adapter_version"
      ],
      "title": "SttRun",
      "type": "object"
    }
  },
  "$id": "run-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/RunView"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "RunList",
  "type": "object"
}
