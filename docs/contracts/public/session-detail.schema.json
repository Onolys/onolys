{
  "$defs": {
    "Flags": {
      "properties": {
        "has_rating": {
          "title": "Has Rating",
          "type": "boolean"
        },
        "rating_submitted": {
          "title": "Rating Submitted",
          "type": "boolean"
        },
        "speaker_confirmed": {
          "title": "Speaker Confirmed",
          "type": "boolean"
        },
        "transcript_ready": {
          "title": "Transcript Ready",
          "type": "boolean"
        }
      },
      "required": [
        "transcript_ready",
        "speaker_confirmed",
        "rating_submitted",
        "has_rating"
      ],
      "title": "Flags",
      "type": "object"
    },
    "SessionCancel": {
      "description": "The result of a user cancel (04-cancel R7): did it use a unit, how many, and when.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "counted": {
          "title": "Counted",
          "type": "boolean"
        },
        "units": {
          "title": "Units",
          "type": "integer"
        }
      },
      "required": [
        "counted",
        "units",
        "at"
      ],
      "title": "SessionCancel",
      "type": "object"
    },
    "SessionErrorInfo": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "SessionErrorInfo",
      "type": "object"
    }
  },
  "$id": "session-detail.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "audio_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Recording duration in seconds",
      "title": "Audio S"
    },
    "cancel": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionCancel"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set once cancelled: whether it used a unit, how many, and when"
    },
    "counted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Did the session end (cancelled or failed) having used a unit; null n/a",
      "title": "Counted"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flags": {
      "$ref": "#/$defs/Flags"
    },
    "free_run": {
      "default": false,
      "description": "True for an interview session whose free run stands: its run, and Try again after a failed free run, cost nothing against the daily evaluation cap.",
      "title": "Free Run",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "interview_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when an AI interview created this session: its first run is free.",
      "title": "Interview Id"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "latest_report_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Report Version"
    },
    "links": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Links",
      "type": "object"
    },
    "n_runs": {
      "title": "N Runs",
      "type": "integer"
    },
    "preset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preset"
    },
    "progress": {
      "title": "Progress",
      "type": "integer"
    },
    "progress_next": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Base percent of the next stage (99 on the last); null when none",
      "title": "Progress Next"
    },
    "stage_expected_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Typical seconds the current stage takes; null when untimed",
      "title": "Stage Expected S"
    },
    "stage_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Entered the current state",
      "title": "Stage Started At"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "First entry to uploading (a re-run: its start); null before",
      "title": "Started At"
    },
    "status": {
      "enum": [
        "created",
        "uploading",
        "validating",
        "transcribing",
        "awaiting_input",
        "running",
        "report_ready",
        "failed",
        "deleting",
        "upload_incomplete",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "waited_ms": {
      "default": 0,
      "description": "Total milliseconds spent waiting for the user input",
      "title": "Waited Ms",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "status",
    "progress",
    "flags",
    "warnings",
    "language",
    "n_runs",
    "created_at",
    "updated_at",
    "links"
  ],
  "title": "SessionDetail",
  "type": "object"
}
