{
  "$defs": {
    "CodedSpan": {
      "additionalProperties": false,
      "description": "Exactly one half-open time (milliseconds) or zero-based turn range.",
      "oneOf": [
        {
          "properties": {
            "end_ms": {
              "type": "integer"
            },
            "end_turn": {
              "type": "null"
            },
            "start_ms": {
              "type": "integer"
            },
            "start_turn": {
              "type": "null"
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        },
        {
          "properties": {
            "end_ms": {
              "type": "null"
            },
            "end_turn": {
              "type": "integer"
            },
            "start_ms": {
              "type": "null"
            },
            "start_turn": {
              "type": "integer"
            }
          },
          "required": [
            "start_turn",
            "end_turn"
          ]
        }
      ],
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "end_turn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Turn"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "start_turn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Turn"
        }
      },
      "title": "CodedSpan",
      "type": "object"
    }
  },
  "$id": "run-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coded_span": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodedSpan"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Half-open milliseconds or zero-based turn range; null codes all turns."
    },
    "n_runs": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default: the session's",
      "title": "N Runs"
    },
    "preset": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Allowlisted; LLM routes only",
      "title": "Preset"
    }
  },
  "title": "RunRequest",
  "type": "object"
}
