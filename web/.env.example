# Copy to .env.local (live mode) and fill in. Only VITE_* variables reach the browser.
# Mock mode (npm run dev:mock) uses .env.mock and needs none of these.

# Set to "true" to serve the API from in-browser MSW handlers.
VITE_USE_MOCKS=false

# API base path. Same-origin /v1 in production (Firebase Hosting rewrite).
VITE_API_BASE_URL=/v1

# Firebase / Identity Platform web config (public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app.onolys.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth emulator URL (mock mode and local dev only), e.g. http://127.0.0.1:9099. Empty = real Firebase.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Firestore status listener (session_status/{id}): `staging` or `(default)`; emulator is dev only (host:port).
VITE_FIRESTORE_DATABASE=(default)
VITE_FIRESTORE_EMULATOR=

# Where account-removal requests go (shown on Settings; filled before launch).
VITE_CONTACT_EMAIL=

# Comma-separated extra hostnames a email-link continueUrl may return to (sibling environments sharing the auth project).
VITE_APP_HOSTS=

# Set to "true" to show the clinician rating card and the rating-vs-Onolys comparison in reports. Absent/anything else = off.
VITE_RATING_ENABLED=false
