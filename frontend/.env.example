# Origin (no path) of the admin backend; the shell calls GET <origin>/v1/me. Inlined at build time.
VITE_ADMIN_API_URL=http://localhost:8000
# Set to exactly "true" to skip the login gate and the backend call (local dev).
VITE_MOCK=true
# Login gate. Renders only when exactly "true" and VITE_MOCK is not "true". Unset for local dev.
# VITE_AUTH_REQUIRED=true
# Identity Platform web config (placeholders; supply per environment at build time). authDomain defaults to admin.onolys.com.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=admin.onolys.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
