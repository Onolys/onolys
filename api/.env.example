# Names are the SP06 env-var interface. Local dev: copy to .env, export, run combined mode.
ENV=local                     # REQUIRED, no default: local|test|staging|prod (local|test refused on Cloud Run)
SERVICE_MODE=combined         # api|worker|combined
AUTH_MODE=fake                # fake (Bearer test:<uid>; only ENV=local|test) | idp
ADAPTERS=stub                 # stub|real
GCP_PROJECT=onolys
REGION=us-central1
FIRESTORE_DATABASE=(default)  # staging | (default)
AUTH_PROJECT=onolys
AUDIO_BUCKET=
CORS_ORIGINS=http://localhost:5173
EVAL_CAP_DAY=10
AI_CAP_DAY=5
MAX_ACTIVE_RUNS=1
STT_CAP_FACTOR=3  # STT poll cap = factor x audio seconds, clamped to [STT_CAP_MIN_S, STT_TIME_LIMIT_S]
STT_CAP_MIN_S=300
STT_TIME_LIMIT_S=1200
TASKS_QUEUE=
TASKS_SA=
WORKER_URL=
ROUTES_FILE=
DEFAULT_PRESET=
PROD_ENGINE=miti
GIT_SHA=dev
UID_HMAC_KEY=                 # required when ENV=staging|prod (Secret Manager uid-hmac-key-{env}); optional locally
