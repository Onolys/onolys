{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@prod-auth/*": ["../../web/src/auth/*"], "@prod-routes/*": ["../../web/src/routes/*"], "@prod-components/*": ["../../web/src/components/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
