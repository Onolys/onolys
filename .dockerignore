# Build context for api/Dockerfile is the repo root; keep it small.
**/.git
.worktrees
**/__pycache__
**/*.pyc
**/.venv
**/node_modules
**/.pytest_cache
**/.ruff_cache
**/.coverage
**/tests
**/dist
docs
web
frontend
infra
**/eval
# uv resolves every workspace member; include only the eval manifests, never its data/source.
!eval/
eval/**
!eval/core/
eval/core/**
!eval/core/pyproject.toml
!eval/auth/
eval/auth/**
!eval/auth/pyproject.toml
!eval/backend/
eval/backend/**
!eval/backend/pyproject.toml
**/datasets
firestore-rules-test
.github
.claude
**/.env
**/.env.*
